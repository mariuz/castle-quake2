<?xml version="1.0" encoding="utf-8"?>

<!--
  Unit tests for the Quake 2 file parsers (PAK, PCX, WAL, BSP, MD2, SP2),
  run against the bundled demo PAK. Build and run:
    castle-engine compile && ./castle-quake2-tests
  See https://castle-engine.io/project_manifest .
-->
<project name="castle-quake2-tests"
  standalone_source="castle_quake2_tests.dpr"
  qualified_name="io.castleengine.castlequake2.tests"
>
  <compiler_options>
    <search_paths>
      <path value="../code/" />
    </search_paths>
  </compiler_options>
  <data exists="false" />
</project>
