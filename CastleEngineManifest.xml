<?xml version="1.0" encoding="utf-8"?>

<!--
  Castle Quake 2: Quake 2 levels, models, sounds and gameplay rendered and played with Castle Game Engine.
  See https://castle-engine.io/project_manifest for documentation of this file.

  editor_units: units with components registered for the CGE editor
  (TQuakeMap, TQuakePlayerMovement, TQuakeHud, TQuakeConsole, TQuakeMenu). Use
  "Project -> Restart Editor (With Custom Components)" to see them.
-->
<project name="castle-quake2"
  standalone_source="castle_quake2_standalone.dpr"
  game_units="GameInitialize"
  editor_units="QuakeMap, QuakePlayer, QuakeHud, QuakeConsole, QuakeMenu, QuakeMonsterTypes, QuakeSound, QuakeLevelEditor"
  qualified_name="io.castleengine.castlequake2"
  caption="Castle Quake 2"
  author="castle-quake2"
  screen_orientation="landscape"
>
  <version value="0.15.0" code="16" />
  <compiler_options>
    <search_paths>
      <path value="code/" />
    </search_paths>
  </compiler_options>
</project>
